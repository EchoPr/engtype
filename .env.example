# Optional: server-wide fallback key. Each user can also paste their own key in /settings.
OPENAI_API_KEY=
# Optional: OpenAI-compatible endpoint (proxy, Azure-compatible gateway, local mock...)
OPENAI_BASE_URL=
# Optional: secret used to encrypt stored API keys. If empty, data/.secret is generated on first run.
APP_SECRET=
# Optional: where app.db lives (default ./data)
DATA_DIR=
# Public base URL used for canonical links, sitemap and Open Graph
SITE_URL=
