# The server pays for one model for all learners (docs/adr/0004-server-paid-model.md).
# Without a key the exam bank and editor work, but AI tasks, reviews and chat are off.

# Provider: deepseek (default) | openai | custom (any OpenAI-compatible API, set AI_BASE_URL)
AI_PROVIDER=deepseek
# API key for that provider. DEEPSEEK_API_KEY / OPENAI_API_KEY are also read as a fallback.
AI_API_KEY=
# Optional overrides; defaults come from the provider preset in src/lib/providers.ts
AI_MODEL=
AI_FAST_MODEL=
AI_BASE_URL=

# Anti-abuse caps per rolling 24 hours (per-plan limits live in src/lib/quota-server.ts)
QUOTA_FULL_PER_IP=6
QUOTA_QUICK_PER_IP=40
QUOTA_GLOBAL_FULL=2000
QUOTA_GLOBAL_QUICK=10000
QUOTA_TASK_PER_IP=40
QUOTA_GLOBAL_TASK=5000
# Proxies in front of the app that append to X-Forwarded-For (1 = a single nginx/Caddy/Fly.io edge)
TRUSTED_PROXY_HOPS=1

# Docker deploy (docker-compose.yml): public host name Caddy serves and gets a certificate for
SITE_DOMAIN=
# Stable Server Action key across rebuilds: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Umami analytics (dashboard at stats.<SITE_DOMAIN>, needs a DNS record for it): openssl rand -base64 32 for both
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
# Website ID from the Umami dashboard (Settings → Websites); baked in at build, empty disables tracking
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Where app.db lives (default ./data)
DATA_DIR=
# Public base URL used for canonical links, sitemap and Open Graph
SITE_URL=

# Only for `pnpm eval:scoring` (paid API calls, run by hand)
EVAL_PROVIDER=openai
EVAL_API_KEY=
EVAL_MODEL=
EVAL_BASE_URL=
