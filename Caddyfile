# Caddy gets and renews the TLS certificate itself. It ignores X-Forwarded-For from clients and sets the real
# client address, which src/lib/request.ts reads as the single trusted hop.
{$SITE_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy app:3000
}
